# Copy to server/.env and adjust.
PORT=4000
# Admin account created on first start (only if no admin exists yet). Change these!
ADMIN_EMAIL=admin@anavrin.co.ke
ADMIN_PASSWORD=Admin@2026
# Long random string used to sign login tokens. Generated and stored in server/data if omitted.
# JWT_SECRET=
# Set to false to skip creating the demo shopper and rider accounts.
SEED_DEMO_USERS=true

# ---------- Maps ----------
# Google Maps (recommended for production). Leave empty to use the free open map (OpenFreeMap).
# Enable "Maps JavaScript API", "Places API (New)" and "Geocoding API" on the key's project,
# and restrict the key to your site's HTTP referrers.
GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud (Map Management). Without one, Google's DEMO_MAP_ID is used.
GOOGLE_MAPS_MAP_ID=
# Where riders collect orders.
STORE_NAME=Anavrin Hub, Westlands
STORE_LAT=-1.2676
STORE_LNG=36.8108
# Open-map place search uses the public OpenStreetMap Nominatim service through this server.
# Its usage policy (https://operations.osmfoundation.org/policies/nominatim/) requires a contact
# and allows at most 1 request per second for the whole app. Point NOMINATIM_URL at your own
# instance (or set a Google key) for real traffic.
NOMINATIM_CONTACT=you@example.com
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Set to true only if a Google Maps feature is blocked by the site's Content-Security-Policy.
# CSP_GOOGLE_COMPAT=false

# Docker Compose options. Copy to .env (next to compose.yaml).
# Port on this machine for plain HTTP access. On a public server running the https profile, use
# 127.0.0.1:8080 so the store is only reachable through HTTPS.
ANAVRIN_PORT=8080
# Your domain for HTTPS (used with: docker compose --profile https up -d). DNS must point here.
DOMAIN=
